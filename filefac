<!-- ═══════════════════════════════════════════ -->
<script>
/* ═══════════════════════════════════════════════════════
   FileFac — logique complète
   Stockage : App.FileFac.save() → localStorage (clé filefac_fiches)
   URL encodée : /f/<base64url enrichi>
═══════════════════════════════════════════════════════ */

/* ── Intégration dans window.App ──────────────────── */
window.App = window.App || {};
window.App.FileFac = {
  DB: 'filefac_fiches',
  load() {
    try { return JSON.parse(localStorage.getItem(this.DB)) || []; }
    catch { return []; }
  },
  save(fiches) {
    localStorage.setItem(this.DB, JSON.stringify(fiches));
  },
  upsert(fiche) {
    const list = this.load();
    const idx  = list.findIndex(f => f.id === fiche.id);
    if (idx >= 0) list[idx] = fiche; else list.unshift(fiche);
    this.save(list);
  },
  remove(id) {
    this.save(this.load().filter(f => f.id !== id));
  },
  get(id) {
    return this.load().find(f => f.id === id) || null;
  }
};

/* ── Génération d'ID ──────────────────────────────── */
function uid() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

/* ── Encodage URL ─────────────────────────────────── */
// Encode les données de la fiche en un token long et opaque
// Format : /f/<token>
// Le token contient : sel aléatoire intercalé + base64url du JSON
function encodeToken(fiche) {
  const payload = JSON.stringify({
    id:      fiche.id,
    titre:   fiche.titre,
    type:    fiche.type,
    details: fiche.details,
    file:    fiche.fileName || '',
    ts:      fiche.createdAt,
  });
  // base64url
  const b64 = btoa(unescape(encodeURIComponent(payload)))
    .replace(/=/g, '')
    .replace(/\+/g, '-')
    .replace(/\//g, '_');

  // Sel aléatoire 16 chars
  const salt = Array.from({length: 16}, () =>
    '0123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz'[
      Math.floor(Math.random() * 58)
    ]).join('');

  // Intercale le sel dans le base64 toutes les 6 chars
  let out = '';
  for (let i = 0; i < b64.length; i++) {
    out += b64[i];
    if ((i + 1) % 6 === 0 && i < salt.length * 6)
      out += salt[Math.floor(i / 6)] ?? '';
  }
  // Ajoute le sel en suffixe pour pouvoir décoder
  return out + '~' + salt;
}

function decodeToken(token) {
  try {
    const [encoded, salt] = token.split('~');
    if (!salt) return null;
    // Retire les chars du sel intercalés
    let b64 = '';
    let saltIdx = 0;
    for (let i = 0; i < encoded.length; i++) {
      if ((i % 7) === 6 && saltIdx < salt.length) {
        // position du sel intercalé (toutes les 7 chars dans la sortie = 6 b64 + 1 sel)
        saltIdx++;
      } else {
        b64 += encoded[i];
      }
    }
    return JSON.parse(decodeURIComponent(escape(atob(
      b64.replace(/-/g, '+').replace(/_/g, '/')
         + '=='.slice(0, (4 - b64.length % 4) % 4)
    ))));
  } catch { return null; }
}

function buildUrl(fiche) {
  const token = encodeToken(fiche);
  return `${location.origin}/f/${token}`;
}

/* ── Toast ────────────────────────────────────────── */
let _tt;
function toast(msg, type = 'ok') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = `toast ${type} show`;
  clearTimeout(_tt);
  _tt = setTimeout(() => el.classList.remove('show'), 2800);
}

/* ── State ────────────────────────────────────────── */
let editingId    = null;
let selectedType = 'pdf';
let selectedFile = '';

/* ── Type pills ───────────────────────────────────── */
document.querySelectorAll('.pill').forEach(p => {
  p.addEventListener('click', () => {
    document.querySelectorAll('.pill').forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    selectedType = p.dataset.t;
    const acc = { pdf: '.pdf', odt: '.odt', word: '.doc,.docx' };
    document.getElementById('f-file').accept = acc[selectedType];
  });
});

/* ── Drop zone ────────────────────────────────────── */
const dz    = document.getElementById('dz');
const fFile = document.getElementById('f-file');
const badge = document.getElementById('dz-badge');

fFile.addEventListener('change', () => {
  if (fFile.files[0]) setFile(fFile.files[0].name);
});
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('over'); });
dz.addEventListener('dragleave', () => dz.classList.remove('over'));
dz.addEventListener('drop', e => {
  e.preventDefault(); dz.classList.remove('over');
  if (e.dataTransfer.files[0]) setFile(e.dataTransfer.files[0].name);
});
function setFile(name) {
  selectedFile = name;
  badge.textContent = '📎 ' + name;
  badge.style.display = 'block';
}

/* ── Sauvegarde ───────────────────────────────────── */
document.getElementById('btn-save').addEventListener('click', save);
document.getElementById('btn-cancel').addEventListener('click', cancelEdit);

function save() {
  const titre   = document.getElementById('f-titre').value.trim();
  const details = document.getElementById('f-details').value.trim();
  if (!titre) { toast('⚠ Renseignez un titre.', 'err'); return; }

  const fiche = {
    id:        editingId || uid(),
    titre,
    type:      selectedType,
    fileName:  selectedFile,
    details,
    createdAt: editingId
      ? (App.FileFac.get(editingId)?.createdAt || new Date().toISOString())
      : new Date().toISOString(),
    updatedAt: new Date().toISOString(),
  };

  App.FileFac.upsert(fiche);
  const url = buildUrl(fiche);
  showUrl(url);
  renderList();
  toast(editingId ? '✓ Fiche mise à jour' : '✓ Fiche créée', 'ok');
  cancelEdit();
}

function showUrl(url) {
  document.getElementById('url-val').textContent = url;
  const box = document.getElementById('url-box');
  box.style.display = 'block';
  box.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

/* ── Edition ──────────────────────────────────────── */
function startEdit(id) {
  const f = App.FileFac.get(id);
  if (!f) return;
  editingId = id;
  document.getElementById('f-titre').value   = f.titre;
  document.getElementById('f-details').value = f.details;
  selectedType = f.type;
  document.querySelectorAll('.pill').forEach(p => {
    p.classList.toggle('active', p.dataset.t === f.type);
  });
  if (f.fileName) {
    selectedFile = f.fileName;
    badge.textContent = '📎 ' + f.fileName;
    badge.style.display = 'block';
  }
  document.getElementById('form-mode-label').textContent = '// Édition de la fiche';
  document.getElementById('btn-cancel').style.display = 'inline-flex';
  document.getElementById('form-card').scrollIntoView({ behavior:'smooth' });
  toast('Mode édition activé', 'info');
}

function cancelEdit() {
  editingId    = null;
  selectedFile = '';
  document.getElementById('f-titre').value   = '';
  document.getElementById('f-details').value = '';
  badge.style.display = 'none'; badge.textContent = '';
  document.querySelectorAll('.pill').forEach((p,i) => p.classList.toggle('active', i===0));
  selectedType = 'pdf';
  document.getElementById('form-mode-label').textContent = '// Nouvelle fiche';
  document.getElementById('btn-cancel').style.display = 'none';
}

/* ── Suppression ──────────────────────────────────── */
function deleteFiche(id) {
  if (!confirm('Supprimer cette fiche ?')) return;
  App.FileFac.remove(id);
  renderList();
  toast('Fiche supprimée', 'err');
}

/* ── Voir URL ─────────────────────────────────────── */
function viewFiche(id) {
  const f = App.FileFac.get(id);
  if (!f) return;
  showUrl(buildUrl(f));
}

/* ── Copier URL ───────────────────────────────────── */
document.getElementById('copy-btn').addEventListener('click', function() {
  const url = document.getElementById('url-val').textContent;
  navigator.clipboard.writeText(url).then(() => {
    this.textContent = 'Copié ✓';
    this.classList.add('ok');
    setTimeout(() => { this.textContent = 'Copier'; this.classList.remove('ok'); }, 2000);
  });
});

/* ── Icônes par type ──────────────────────────────── */
const ICONS = { pdf:'📄', odt:'📝', word:'📘' };
const ICO_CLS = { pdf:'ico-pdf', odt:'ico-odt', word:'ico-word' };

/* ── Rendu de la liste ────────────────────────────── */
function renderList() {
  const fiches = App.FileFac.load();
  const list   = document.getElementById('list');
  const count  = document.getElementById('count');
  count.textContent = fiches.length + ' fiche' + (fiches.length > 1 ? 's' : '');

  if (!fiches.length) {
    list.innerHTML = `<div class="empty">
      <div class="empty-ico">🗂</div>
      Aucune fiche enregistrée — créez-en une ci-dessus.
    </div>`;
    return;
  }

  list.innerHTML = fiches.map(f => {
    const dt = new Date(f.updatedAt || f.createdAt).toLocaleDateString('fr-FR', {
      day:'2-digit', month:'short', year:'numeric'
    });
    const meta = [f.fileName || f.type.toUpperCase(), dt].filter(Boolean).join(' · ');
    return `<div class="fiche">
      <div class="fiche-ico ${ICO_CLS[f.type]}">${ICONS[f.type]}</div>
      <div class="fiche-body">
        <h3>${esc(f.titre)}</h3>
        <div class="fiche-meta">${esc(meta)}</div>
      </div>
      <div class="fiche-acts">
        <button class="btn btn-view" onclick="viewFiche('${f.id}')">🔗 URL</button>
        <button class="btn btn-edit" onclick="startEdit('${f.id}')">✏️ Éditer</button>
        <button class="btn btn-del"  onclick="deleteFiche('${f.id}')">🗑</button>
      </div>
    </div>`;
  }).join('');
}

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/* ── Route /f/<token> : lecture de la fiche ────────── */
// Si on arrive sur /f/<token>, on affiche la vue de la fiche
(function checkRoute() {
  const m = location.pathname.match(/^\/f\/(.+)$/);
  if (!m) { renderList(); return; }

  const data = decodeToken(decodeURIComponent(m[1]));
  if (!data) {
    document.querySelector('main').innerHTML = `
      <div style="text-align:center;padding:80px 20px">
        <div style="font-size:48px;margin-bottom:20px">❌</div>
        <h1 style="font-size:28px;font-weight:800;margin-bottom:10px">URL invalide</h1>
        <p style="color:var(--muted2)">Ce lien ne correspond à aucune fiche valide.</p>
        <a href="/filefac.html" style="margin-top:24px;display:inline-block;color:var(--gold)">← Retour FileFac</a>
      </div>`;
    return;
  }

  // Affichage de la fiche depuis l'URL
  const typeLabel = { pdf:'PDF', odt:'ODT', word:'Word' }[data.type] || data.type;
  const dt = data.ts ? new Date(data.ts).toLocaleDateString('fr-FR', {
    weekday:'long', day:'numeric', month:'long', year:'numeric'
  }) : '—';

  document.querySelector('main').innerHTML = `
    <div style="max-width:640px;margin:0 auto">
      <a href="/filefac.html" style="font-size:12px;color:var(--muted2);text-decoration:none;
         font-family:'DM Mono',monospace;letter-spacing:.08em;
         display:inline-flex;align-items:center;gap:6px;margin-bottom:32px">
        ← Toutes les fiches
      </a>
      <div class="card">
        <div class="card-stripe"></div>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px">
          <div class="fiche-ico ${ICO_CLS[data.type] || 'ico-pdf'}" style="width:52px;height:52px;font-size:24px">
            ${ICONS[data.type] || '📄'}
          </div>
          <div>
            <div style="font-size:11px;font-family:'DM Mono',monospace;letter-spacing:.12em;
                        text-transform:uppercase;color:var(--muted2);margin-bottom:4px">
              Fiche ${typeLabel}
            </div>
            <h1 style="font-size:22px;font-weight:800;line-height:1.2">${esc(data.titre)}</h1>
          </div>
        </div>
        ${data.details ? `
        <div style="background:rgba(0,0,0,.3);border:1px solid var(--border2);border-radius:var(--r);
                    padding:16px 18px;margin-bottom:18px">
          <div style="font-size:10px;font-family:'DM Mono',monospace;letter-spacing:.14em;
                      text-transform:uppercase;color:var(--muted);margin-bottom:8px">Détails</div>
          <p style="font-size:14px;color:var(--txt);line-height:1.7;white-space:pre-wrap">${esc(data.details)}</p>
        </div>` : ''}
        <div style="display:flex;gap:20px;flex-wrap:wrap">
          ${data.file ? `<div>
            <div style="font-size:10px;font-family:'DM Mono',monospace;letter-spacing:.14em;
                        text-transform:uppercase;color:var(--muted);margin-bottom:4px">Fichier</div>
            <div style="font-size:13px;font-family:'DM Mono',monospace;color:var(--blue2)">${esc(data.file)}</div>
          </div>` : ''}
          <div>
            <div style="font-size:10px;font-family:'DM Mono',monospace;letter-spacing:.14em;
                        text-transform:uppercase;color:var(--muted);margin-bottom:4px">Créée le</div>
            <div style="font-size:13px;color:var(--muted2)">${dt}</div>
          </div>
        </div>
      </div>
      <div style="margin-top:12px">
        <div class="url-box-inner">
          <span class="url-val" style="font-size:10.5px">${esc(location.href)}</span>
          <button class="copy-btn" onclick="navigator.clipboard.writeText(location.href);this.textContent='Copié ✓';this.classList.add('ok')">Copier</button>
        </div>
      </div>
    </div>`;
})();
</script>
</body>
</html>
